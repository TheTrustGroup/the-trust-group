# EmailJS Configuration
# Get these values from https://www.emailjs.com/
# After signing up, create a service and template, then add your credentials here
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here
# Optional server-only key for EmailJS REST API (recommended in production)
EMAILJS_PRIVATE_KEY=your_emailjs_private_key_here
EMAILJS_BRIEFING_TEMPLATE_ID=your_briefing_template_id_here

# Contact delivery target
CONTACT_TO_EMAIL=info@thetrustgroupsolutions.com

# Rate limiting (server API)
CONTACT_RATE_LIMIT_MAX=8
CONTACT_RATE_LIMIT_WINDOW_MS=900000
BRIEFING_RATE_LIMIT_MAX=5
BRIEFING_RATE_LIMIT_WINDOW_MS=900000

# Cloudflare Turnstile (optional but recommended)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Google Maps API (Optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id_here
